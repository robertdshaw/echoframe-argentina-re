# EchoFrame Argentina RE Intelligence — environment template.
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored; `.env.example` IS committed and must contain
# placeholders only.

# ──────────────────────────────────────────────────────────────────────
# Live data sources (optional)
# ──────────────────────────────────────────────────────────────────────

# NewsData.io — Spanish-language Argentine news feed.
# Free tier: 200 requests/day. Get a key at https://newsdata.io/register
# When unset (or a placeholder like "your_key"), NewsSeeder JSON is used.
NEWSDATA_API_KEY=

# FRED (St. Louis Fed) — used as BCRA fallback for USD/ARS and inflation.
# Free, requires registration: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# OpenAI / Anthropic — currently unused (NLP is rule-based per CLAUDE.md).
# Provide a key only if you wire LLM-based classification later.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Feature flags (defaults are fine for demo)
# ──────────────────────────────────────────────────────────────────────

# ENVIRONMENT=demo
# DEBUG=false
# ENABLE_LIVE_APIS=true
# ENABLE_NLP_PROCESSING=true
# ENABLE_REGIME_DETECTION=true
# ENABLE_BEHAVIORAL_ADJUSTMENTS=true
